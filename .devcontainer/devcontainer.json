{
  "name": "Ceph Development",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "CEPH_RELEASE": "20.2.4"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "2.38.4"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.27.3",
      "golangciLintVersion": "2.15.0"
    },
    "ghcr.io/devcontainers-extra/features/gh-cli:1": {
      "version": "2.103.0"
    },
    "ghcr.io/devcontainers-extra/features/opentofu:1": {
      "version": "1.13.2"
    },
    "ghcr.io/devcontainers-extra/features/terraform-asdf:2": {
      "version": "1.16.7"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "forwardPorts": [
    7480,
    8080
  ],
  "runArgs": [
    "--add-host=s3.storage.host:127.0.0.1",
    "--add-host=test-basic-bucket.s3.storage.host:127.0.0.1",
    "--add-host=test-static-bucket.s3-website.storage.host:127.0.0.1"
  ],
  "mounts": [
    "source=ceph-bash-history-${devcontainerId},target=/command-history,type=volume",
    "source=ceph-external-files-${devcontainerId},target=/external-files,type=volume"
  ],
  "remoteUser": "vscode",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces,type=bind,consistency=delegated",
  "workspaceFolder": "/workspaces"
}
